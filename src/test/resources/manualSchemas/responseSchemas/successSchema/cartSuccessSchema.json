{
    "$schema": "http://json-schema.org/draft-06/schema#",
    "$ref": "#/definitions/Welcome",
    "definitions": {
        "Welcome": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "items": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/Item"
                    }
                },
                "total": {
                    "type": "number"
                }
            },
            "required": [
                "items",
                "total"
            ],
            "title": "Welcome"
        },
        "Item": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "productId": {
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                },
                "unitPrice": {
                    "type": "number"
                },
                "quantity": {
                    "type": "integer"
                },
                "lineTotal": {
                    "type": "number"
                }
            },
            "required": [
                "lineTotal",
                "name",
                "productId",
                "quantity",
                "unitPrice"
            ],
            "title": "Item"
        }
    }
}
